# Copy to .env (never commit real values).
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/taskboard

# Generate long random values, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
